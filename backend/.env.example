# Server
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS) - set this to your deployed frontend URL in production
CLIENT_URL=http://localhost:5173

# OpenAI
# If left empty, the app automatically falls back to a rule-based
# (non-AI) generation engine so the whole platform still works
# instantly without any API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Uploads
MAX_FILE_SIZE_MB=8
